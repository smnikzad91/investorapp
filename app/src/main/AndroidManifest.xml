<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Used only for the local "you have unseen notifications" badge posted by the polling
         worker (no FCM push yet, see NotificationsPollWorker). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for the in-app update flow's install prompt (ACTION_VIEW on the downloaded APK)
         to work at all on API 26+ — without this declared, the OS never offers the per-app
         "install unknown apps" toggle and the install attempt just silently fails (a logcat
         error, no crash, no visible error in the app — exactly what "nothing happens on tap"
         looks like). This does NOT auto-grant the permission itself; see
         ApkDownloader.launchInstaller for the canRequestPackageInstalls() check that sends the
         user to grant it the first time. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TradeBotApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TradeBotInvestor"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Theme.TradeBotInvestor.Splash (not the base theme) so the system splash screen is
             what's shown at cold start; installSplashScreen() in MainActivity hands off to
             Theme.TradeBotInvestor itself once the update check resolves. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TradeBotInvestor.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the downloaded update APK to the system package installer via a content://
             URI — a raw file:// URI throws FileUriExposedException on API 24+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Opts into appcompat 1.6.0+'s automatic persistence of AppCompatDelegate's per-app
             locale across process/app restarts (API < 33 — on 33+ the platform handles this
             itself). Without this block, LanguageManager.setLanguage() only survives for the
             current process; the app reverts to the device/default language on the next
             cold start. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
